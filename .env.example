# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (prisma/schema.prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME

# Local database in Docker (compose.yaml). Docker Compose reads these from .env.
# With it, DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5433/photo_album
POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# POSTGRES_DB=photo_album

# JWT signing secrets: long random strings, different from each other.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
REFRESH_SECRET=

# HTTP port (defaults to 3000 when unset)
PORT=4000

# "production" turns off pretty logs
NODE_ENV=development

# Proxies Express trusts for the client IP (rate limiting reads it). Leave unset locally.
# Behind nginx/Caddy on the same machine: loopback. Otherwise the proxy's IP or CIDR.
# Never "true": it trusts any client's X-Forwarded-For, so limits can be bypassed.
# TRUST_PROXY=loopback

# Shared with the frontend server, which sends it in the X-Frontend-Secret header.
# Requests carrying it skip rate limiting (visitors are limited in front of the frontend).
# Unset means nothing skips. Use the same value in the frontend's server-only env.
# Generate with the same command as the JWT secrets.
FRONTEND_API_SECRET=

# Sign-up via POST /users. Closed unless exactly "true"; leave unset or "false" in production.
REGISTRATION_ENABLED=true

# Per-user upload quota. Not enforced yet: the check comes with direct-to-S3 uploads.
# Storage limit in bytes (20 GiB = 20 * 1024^3).
MAX_STORAGE_BYTES_PER_USER=21474836480
MAX_PHOTOS_PER_USER=6000
